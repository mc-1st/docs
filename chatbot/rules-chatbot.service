[Unit]
Description=MC-1ST rules chatbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/mc-1st-docs/chatbot
EnvironmentFile=/etc/mc-1st-rules-chatbot.env
ExecStartPre=/usr/bin/node /root/mc-1st-docs/chatbot/build-index.mjs
ExecStart=/usr/bin/node /root/mc-1st-docs/chatbot/server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/mc-1st-docs/chatbot/data

[Install]
WantedBy=multi-user.target
